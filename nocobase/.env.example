# ============================================================
# NocoBase Environment Configuration Template
# Copy this file to .env and fill in your values
#   copy .env.example .env
# ============================================================

# --- Application ---
APP_ENV=development
APP_KEY=replace-with-a-random-64-byte-base64-key
APP_PORT=13000

# --- API ---
API_BASE_PATH=/api/
API_BASE_URL=

# --- Plugin ---
PLUGIN_PACKAGE_PREFIX=

# --- Database (PostgreSQL) ---
DB_LOGGING=off
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nocobase
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# --- Initial Admin User (created on first install) ---
INIT_ROOT_EMAIL=admin@nocobase.com
INIT_ROOT_PASSWORD=admin123
INIT_ROOT_NICKNAME=Super Admin
INIT_ROOT_USERNAME=nocobase
